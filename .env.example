# Pipsey local development template. NEVER commit .env or actual secrets.
# Production app should put API credentials in macOS Keychain, not plaintext files.
PIPSEY_VLM_BASE_URL=https://replace-with-vlm-endpoint.example.invalid
PIPSEY_VLM_MODEL=UNSELECTED_BENCHMARK_REQUIRED
PIPSEY_VLM_API_KEY=
PIPSEY_TEXT_BASE_URL=https://replace-with-text-endpoint.example.invalid
PIPSEY_TEXT_MODEL=UNSELECTED_BENCHMARK_REQUIRED
PIPSEY_TEXT_API_KEY=
# User-mediated capture (not continuous or automatic uploads)
PIPSEY_MAX_SESSION_SECONDS=30
PIPSEY_DEFAULT_SAMPLE_FPS=2
PIPSEY_MAX_FRAMES=120
PIPSEY_REQUIRE_UPLOAD_CONSENT=true
PIPSEY_LOG_LEVEL=info
# Hosting provider / ION endpoint remains unverified. No cloud account auto-provisioning.
